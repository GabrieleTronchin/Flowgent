<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test helpers wait on short in-memory operations; passing the test token everywhere adds noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- FEAT-002 handler/pool tests build a REAL in-process MCP server over in-memory pipes (no network). -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each TestEngine spins up the full runtime in-process and drives MAF runs with per-run checkpoint I/O; running
         classes in parallel overloads the machine and flakes the bounded HITL/terminal waits. Run serially. -->
    <Content Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine\Flowgent.Definitions\Flowgent.Definitions.csproj" />
    <ProjectReference Include="..\..\src\Engine\Flowgent.Persistence\Flowgent.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Engine\Flowgent.Runtime\Flowgent.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Services\Flowgent.Engine.Service\Flowgent.Engine.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
