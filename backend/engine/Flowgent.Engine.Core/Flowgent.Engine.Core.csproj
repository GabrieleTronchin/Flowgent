<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Flowgent engine core: run intake, inbox and orchestration, module catalog, MAF workflow building and execution, LLM access.</Description>
  </PropertyGroup>

  <!-- MAF declarative APIs are marked "evaluation only" and emit experimental warnings. They are
       suppressed here, for this project only: MEAI001 (Microsoft.Extensions.AI), MAAI001 (Microsoft.Agents.AI)
       and OPENAI001 (OpenAI, via Microsoft.Agents.AI.OpenAI). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MEAI001;MAAI001;OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows.Declarative" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- MCP client (over Streamable HTTP). The client package does not reference any Microsoft.AspNetCore assembly,
         so using it here keeps the rule "Definitions and Engine.Core do not depend on ASP.NET Core" true. -->
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Flowgent.Definitions\Flowgent.Definitions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowgent.Engine.Tests" />
    <InternalsVisibleTo Include="Flowgent.Persistence" />
    <InternalsVisibleTo Include="Flowgent.Engine.Service" />
  </ItemGroup>

</Project>
