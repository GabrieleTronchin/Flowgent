<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>flowgent-apphost</UserSecretsId>
    <!-- Orchestration dependencies come from NuGet (no Aspire CLI needed): dotnet run is enough. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\hosting\Flowgent.Hosting\Flowgent.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\engine\Flowgent.Engine.Service\Flowgent.Engine.Service.csproj" />
    <ProjectReference Include="..\gateway\Flowgent.Gateway\Flowgent.Gateway.csproj" />
    <ProjectReference Include="..\template\service\Flowgent.Modules.Template.csproj" />
  </ItemGroup>

</Project>
