<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Flowgent engine runtime: workflow compilation and execution, step kinds, LLM access, module catalog, inbox.</Description>
  </PropertyGroup>

  <!-- MAF declarative APIs are marked "evaluation only" and emit experimental diagnostics.
       Suppressed here (scoped to THIS project only, never global): MEAI001 (Microsoft.Extensions.AI),
       MAAI001 (Microsoft.Agents.AI), OPENAI001 (OpenAI, via Microsoft.Agents.AI.OpenAI).
       IDs confirmed by FEAT-001 setup gate (restore+build) and the spike reflection probe. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MEAI001;MAAI001;OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows.Declarative" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- FEAT-002: MCP client (over Streamable HTTP). Gate-0/FEAT-001 proved the client package
         ModelContextProtocol.Core references NO Microsoft.AspNetCore.* assembly, so referencing it
         here keeps DefinitionsAndRuntime_DoNotDependOnAspNetCore green (design §2.8). -->
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowgent.Definitions\Flowgent.Definitions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowgent.Engine.Tests" />
    <InternalsVisibleTo Include="Flowgent.Persistence" />
    <InternalsVisibleTo Include="Flowgent.Engine.Service" />
  </ItemGroup>

</Project>
