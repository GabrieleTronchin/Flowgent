{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "samples/Flowgent.Samples.slnx", "-nodeReuse:false", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--solution", "backend/Flowgent.Core.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: samples",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--solution", "samples/Flowgent.Samples.slnx"],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dashboard: install",
      "type": "process",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}/dashboard" },
      "problemMatcher": []
    }
  ]
}
