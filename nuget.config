<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-root NuGet config. Applies to every project in the repository, including any
  new top-level folders added later (e.g. docker/, tools/).

  Why this exists: the user-level NuGet.Config enables an authenticated private
  Azure DevOps feed (TecCom). For projects not covered by a closer nuget.config it
  would be probed on restore and hang waiting for credentials. We clear all sources
  and use only nuget.org so restores are deterministic and offline-friendly.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
