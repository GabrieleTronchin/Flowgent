<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UserSecretsId>flowgent-samples-apphost</UserSecretsId>
    <!-- Orchestration dependencies come from NuGet (no Aspire CLI needed): dotnet run is enough. -->
