<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The spike lives outside backend/, so it would otherwise inherit the user-level
       NuGet.Config, which has an authenticated private Azure DevOps feed that hangs the
       restore. Clear everything and use only nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
