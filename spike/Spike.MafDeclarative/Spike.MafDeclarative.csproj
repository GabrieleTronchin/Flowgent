<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- This spike is deliberately OUTSIDE backend/ and does not import the central
         package management there. Packages are pinned explicitly here. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- MAF declarative + MCP surfaces are flagged experimental; silence those so the
         spike can build. Each suppressed id is noted in README Findings. -->
    <NoWarn>$(NoWarn);MEAI001;OPENAI001;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.27.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.27.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows.Declarative" Version="1.27.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The YAML workflow is read from disk at runtime; copy it next to the binary. -->
    <None Update="workflow.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="workflow.mcp.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="workflow.hitl.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="workflow.hitl.question.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="workflow.probeA.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="workflow.probeC_malformed.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
